# Sanity CMS (https://sanity.io) — powers /studio and the content fetched
# by lib/sanity.queries.ts. Leave these unset and the site falls back to
# the static content in lib/*.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only read token, needed only if the dataset is private or you want
# to preview unpublished drafts. Create it in manage.sanity.io under
# API > Tokens with "Viewer" permissions. Never expose this with a
# NEXT_PUBLIC_ prefix.
SANITY_API_READ_TOKEN=

# Resend (https://resend.com) — used by lib/email.ts to send the contact
# form notification and the visitor auto-reply. Requires the javeagency.com
# domain to be verified in the Resend dashboard before RESEND_FROM_EMAIL
# will send successfully.
RESEND_API_KEY=

# Inbox that receives every contact form submission.
CONTACT_EMAIL=hello@javeagency.com

# Verified sending address shown to visitors as the "from" of both the
# internal notification and the auto-reply.
RESEND_FROM_EMAIL=hello@javeagency.com
