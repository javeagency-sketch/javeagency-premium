# Resend (https://resend.com) — used by lib/email.ts to send the contact
# form notification and the visitor auto-reply. Requires the javeagency.com
# domain to be verified in the Resend dashboard before PUBLIC_FROM_EMAIL
# will send successfully.
RESEND_API_KEY=

# Inbox that receives every contact form submission.
CONTACT_TO_EMAIL=jave.agency@gmail.com

# Verified sending address shown to visitors as the "from" of both the
# internal notification and the auto-reply.
PUBLIC_FROM_EMAIL=hello@javeagency.com
